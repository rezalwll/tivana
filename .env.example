# آدرس نهایی سایت برای ساخت sitemap.xml و robots.txt
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# اطلاعات رسمی گالری؛ مواردی که ندارید خالی بگذارید.
NEXT_PUBLIC_CONTACT_PHONE=+982100000000
NEXT_PUBLIC_WHATSAPP_NUMBER=989120000000
NEXT_PUBLIC_INSTAGRAM_HANDLE=tivana.example
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_BUSINESS_CITY=تهران

# فقط بعد از تطبیق کامل داده‌های واقعی، مقدار این گزینه‌ها را true کنید.
TIVANA_CATALOG_CONFIRMED=false
TIVANA_POLICIES_CONFIRMED=false
TIVANA_SHARED_PRODUCT_IMAGES_CONFIRMED=false
